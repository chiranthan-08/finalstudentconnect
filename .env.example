# ==============================================================================
# Student Connect - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# For MongoDB Atlas:
#   1. Create a free M0 cluster at https://cloud.mongodb.com
#   2. Add a Database User (Read/Write to Any Database)
#   3. In Network Access, add your server IP or 0.0.0.0/0 (development)
#   4. Replace <username>, <password>, and cluster domain below:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studentconnect?retryWrites=true&w=majority&appName=StudentConnect
MONGODB_URI=mongodb://127.0.0.1:27017/studentconnect

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Secure random 256-bit secret key used to sign and verify JWT tokens
JWT_SECRET=super_secret_jwt_studentconnect_2025_karnataka_key_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT & SERVER PORTS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR BOOTSTRAP CREDENTIALS
# ------------------------------------------------------------------------------
# Used by "npm run seed" to bootstrap the primary platform administrator
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@studentconnect.edu
ADMIN_DEFAULT_PASSWORD=Admin@SC2025!

# ------------------------------------------------------------------------------
# 5. EMAIL PROVIDER CONFIGURATION (Gmail SMTP / Verification / Invoices)
# ------------------------------------------------------------------------------
# To use Gmail SMTP:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Generate an "App Password" (16 characters)
# 3. Enter your gmail and the app password below:
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_FROM="StudentConnect Karnataka" <your_email@gmail.com>

# Optional Resend API key fallback:
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 6. AI ASSISTANT & ACCESSIBILITY (Google Gemini API)
# ------------------------------------------------------------------------------
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY INTEGRATION (Razorpay / Stripe)
# ------------------------------------------------------------------------------
# Verified payment webhook processing points
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_verification_secret
